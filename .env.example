# Адрес API для сборки. В проде — переменная в панели Timeweb Apps:
#   VITE_API_BASE_URL=https://team-api.easyapps.click/api
# Локально не задаётся: запросы идут на /api и проксируются vite.
VITE_API_BASE_URL=

# Куда vite проксирует /api при разработке (по умолчанию локальный team-api :3100).
# VITE_PROXY_TARGET=https://team-api.easyapps.click
# Боевой API принимает изменения только со своего фронта — подставьте его Origin:
# VITE_PROXY_ORIGIN=https://team.easyapps.click
