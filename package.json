{
  "name": "easyapps-team-web-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "orval",
    "swagger": "cd ../easyapps-web-server && npx ts-node -r tsconfig-paths/register scripts/build-swagger-json.ts --service team-api ../easyapps-team-web-client/swagger.json",
    "api": "npm run swagger && npm run generate"
  },
  "dependencies": {
